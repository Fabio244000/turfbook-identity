# Local development only (docker-compose). AWS Lambda never reads .env: its values come
# from SSM / Secrets Manager at deploy time (see serverless.yml and deploy/env/).

# Admin of the local Postgres container (only used to initialize it).
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...

# Service database and user, created on the first start by scripts/database/ (same as AWS).
SERVICE_DB_NAME=turfbook_identity_dev
SERVICE_DB_USER=turfbook_identity_dev_user
SERVICE_DB_PASSWORD=...

# The app connects with the service user, never with the admin.
DATABASE_URL=postgresql+psycopg://turfbook_identity_dev_user:<pass>@db:5432/turfbook_identity_dev

# Session token (RS256). Generate a local pair (never commit it):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# and paste private.pem here in double quotes, over several lines.
JWT_PRIVATE_KEY="several lines"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Optional: they have a default in Settings. Uncomment only to use another value.
# REFRESH_TOKEN_EXPIRE_DAYS=7
# REFRESH_TOKEN_BYTES=32
